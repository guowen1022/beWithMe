# beWithMe -- environment template.
#
#   cp .env.example .env    then fill in the real values.
#
# .env is gitignored and must NEVER be committed or baked into an image.
# The full reference for every variable is CLAUDE.md > Environment Variables.
#
# Config homes (per CLAUDE.md):
#   config.yaml            -- base_port, service_host
#   silicon_brain/config.py-- DATABASE_URL
#   infra/config.py        -- OLLAMA_URL, EMBEDDING_*, LLM_*, DEEPSEEK_*, DOUBAO_*, SKILLFORGE_*
#   services/transcribe/main.py -- WHISPER_*, EOU_*
#   services/speak/main.py -- KOKORO_*

# ---- Persistence -----------------------------------------------------------
# Local:  postgresql+asyncpg://bewithme:bewithme@localhost:5432/bewithme
# Docker: postgresql+asyncpg://bewithme:bewithme@postgres:5432/bewithme
# AliCloud RDS: postgresql+asyncpg://<user>:<pw>@<rds-host>:5432/bewithme
DATABASE_URL=postgresql+asyncpg://bewithme:bewithme@localhost:5432/bewithme
POSTGRES_PASSWORD=bewithme

# ---- Embeddings ------------------------------------------------------------
# Requires: ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434

# ---- Reasoning LLM ---------------------------------------------------------
# NOTE: infra/model/llm.py validates these at IMPORT time and raises
# RuntimeError if the active provider's vars are unset. There are no defaults.
LLM_PROVIDER=deepseek

# Required when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Required when LLM_PROVIDER=minimax (Anthropic-compatible endpoint)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# LLM_MODEL=MiniMax-M2.7-highspeed

# ---- Vision (independent of LLM_PROVIDER) ----------------------------------
# Also validated at import time -- see infra/model/vision/__init__.py
VISION_PROVIDER=doubao
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL=

# ---- Speech: local model artifacts (NOT in git, NOT in the image) ----------
# Mounted at /models in the media container.
WHISPER_MODEL_PATH=
WHISPER_THREADS=4
# Fetch with scripts/fetch_eou_model.sh. Unset -> /api/eou returns 503 and the
# ambient gates fail open (no disfluency handling), which is a valid config.
EOU_MODEL_PATH=
EOU_TOKENIZER_PATH=
EOU_THRESHOLD=0.55

# ---- Behavior knobs --------------------------------------------------------
# 1 = show Mirror block, teacher-thinking panel, Electron DevTools. 0 in prod.
BEWITHME_DEBUG=0
FEED_SCHED_INTERVAL_SECONDS=3600

# ---- skillforge tuning (all three set -> tuning sidecar self-registers) ----
# Any unset -> registration skipped, adapter fails open, baseline served.
SKILLFORGE_EDGE_URL=
SKILLFORGE_STORE_URL=
SKILLFORGE_EVAL_SVC_URL=

# ---- Networking ------------------------------------------------------------
# Hosts that bypass http_proxy/https_proxy. Leading dot = subdomain match.
# no_proxy=api.deepseek.com,.minimaxi.com,.volces.com
